{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIS periodic plan v1 (validate_plan enforces full bounds)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "interval_s": {"type": "integer", "minimum": 60, "maximum": 86400},
    "window_ms": {"type": "integer", "minimum": 100, "maximum": 2000},
    "targets_per_session": {"type": "integer", "minimum": 1, "maximum": 2},
    "jitter_ms": {"type": "integer", "minimum": 0, "maximum": 5000},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "min_samples": {"type": "integer", "minimum": 1, "maximum": 10000},
    "max_sample_age_s": {"type": "integer", "minimum": 0, "maximum": 2678400},
    "process_cpu_ms": {"type": "integer", "minimum": 50, "maximum": 2000},
    "prepare_cpu_ms": {"type": "integer", "minimum": 10, "maximum": 1000},
    "drain_cpu_ms": {"type": "integer", "minimum": 10, "maximum": 1000},
    "rss_bytes": {"type": "integer", "minimum": 16777216, "maximum": 67108864},
    "disk_bytes": {"type": "integer", "minimum": 33554432, "maximum": 1073741824},
    "retain_seconds": {"type": "integer", "minimum": 60, "maximum": 2678400},
    "retain_sessions": {"type": "integer", "minimum": 1, "maximum": 128}
  }
}
